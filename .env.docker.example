# Copier vers .env.docker. Ne jamais y recopier une base ou des données privées.
# Domaine ou sous-domaine pointant vers le serveur Docker, sans https:// ni chemin.
DOMAIN=
IMAGE_TAG=local
# Au premier lancement : secret aléatoire de 32 caractères minimum.
# Génération : node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Après création du compte : peut être vidé, le compte est conservé sur le volume.
ADMIN_SETUP_TOKEN=
MEDIA_STORAGE=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
