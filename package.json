{
  "name": "teranga-atlas-immobilier",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env apps/api/src/start.mjs",
    "test:api": "node --test tests/api.test.mjs",
    "test:production": "node --test tests/production.test.mjs",
    "backup": "node --env-file-if-exists=.env apps/api/src/backup.mjs",
    "backup:verify": "node --env-file-if-exists=.env apps/api/src/verify-backup.mjs",
    "check:production": "node --env-file-if-exists=.env apps/api/src/preflight.mjs",
    "dev": "node --env-file-if-exists=.env node_modules/vite/bin/vite.js --config apps/web/vite.config.mjs",
    "build": "vite build --config apps/web/vite.config.mjs && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview --config apps/web/vite.config.mjs",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "nodemailer": "^10.1.7",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.2"
  }
}
