# Développement local — copier vers .env si nécessaire. Aucun secret réel.
NODE_ENV=development
HOST=127.0.0.1
PORT=4173
TAI_DATA_DIR=var/data
MEDIA_STORAGE=local
# Optionnel : activer Cloudinary pour les nouveaux imports.
# MEDIA_STORAGE=cloudinary
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# Production Railway : variables dans le tableau de bord, pas ce fichier local.
# NODE_ENV=production
# HOST=0.0.0.0
# TAI_DATA_DIR=/data
# TRUST_RAILWAY_PROXY=true
# PUBLIC_ORIGIN=https://votre-domaine
# ADMIN_SETUP_TOKEN= (secret aléatoire de 32 caractères minimum au premier accès)
# Notifications et récupération (laisser HOST et FROM absents tant que non configurés)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=
